      "expected": {
        "method": "POST",
        "path": "napi/caro/ai/finish",
        "body": {
          "gameId": "game-1",
          "moves": []
        }
      },
      "legacy": "api/caroAiFinish.js buildCaroAiFinish"
    },
    {
      "name": "missing gameId is rejected",
      "input": {
        "moves": []
      },
      "error": "at gameId"
    },
    {
      "name": "missing moves is rejected",
      "input": {
        "gameId": "game-1"
