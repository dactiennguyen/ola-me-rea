{
  "endpoint": "getLikesV2",
  "cases": [
    {
      "name": "postID with default page",
      "input": {
        "postID": "540919"
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getLikesV2.php",
        "body": {
          "postID": "540919",
          "page": 0
        }
      },
      "legacy": "api/getLikesV2.js buildGetLikesV2"
    },
    {
      "name": "postID and page",
      "input": {
        "postID": "540919",
        "page": 2
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getLikesV2.php",
        "body": {
          "postID": "540919",
          "page": 2
        }
      },
      "legacy": "api/getLikesV2.js buildGetLikesV2"
    },
    {
      "name": "missing postID is rejected",
      "input": {},
      "error": "at postID"
    },
    {
      "name": "numeric postID is rejected",
      "input": {
        "postID": 540919
      },
      "error": "at postID"
    },
    {
      "name": "negative page is rejected",
      "input": {
        "postID": "540919",
        "page": -1
      },
      "error": "at page"
    }
  ]
}
