{
  "endpoint": "getNotiCountLove",
  "cases": [
    {
      "name": "uid defaults to the signed-in account",
      "input": {},
      "expected": {
        "method": "POST",
        "path": "faApi2/getNotiCountLove.php",
        "body": {
          "uid": "me-uid"
        }
      },
      "legacy": "api/getNotiCountLove.js buildGetNotiCountLove"
    },
    {
      "name": "with count",
      "input": {
        "count": 0
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getNotiCountLove.php",
        "body": {
          "uid": "me-uid",
          "count": 0
        }
      },
      "legacy": "api/getNotiCountLove.js buildGetNotiCountLove"
    },
    {
      "name": "explicit uid",
      "input": {
        "uid": "other-uid",
        "count": 3
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getNotiCountLove.php",
        "body": {
          "uid": "other-uid",
          "count": 3
        }
      },
      "legacy": "api/getNotiCountLove.js buildGetNotiCountLove"
    },
    {
      "name": "negative count is rejected",
      "input": {
        "count": -1
      },
      "error": "at count"
    },
    {
      "name": "empty uid is rejected",
      "input": {
        "uid": ""
      },
      "error": "at uid"
    }
  ]
}
