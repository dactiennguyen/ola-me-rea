      "input": {
        "page": 1
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getMatchV2.php",
        "body": {
          "uid": "me-uid",
          "page": 1
        }
      },
      "legacy": "api/getMatchV2.js buildGetMatchV2"
    },
    {
      "name": "explicit uid",
      "input": {
        "uid": "other-uid",
        "page": 0
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getMatchV2.php",
        "body": {
          "uid": "other-uid",
          "page": 0
        }
      },
      "legacy": "api/getMatchV2.js buildGetMatchV2"
    },
    {
      "name": "negative page is rejected",
