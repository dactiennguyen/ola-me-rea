{
  "endpoint": "checkUV2",
  "cases": [
    {
      "name": "uid defaults to the signed-in account",
      "input": {},
      "expected": {
        "method": "POST",
        "path": "faApi2/checkUV2.php",
        "body": {
          "uid": "me-uid"
        }
      },
      "legacy": "api/checkUV2.js buildCheckUV2"
    },
    {
      "name": "explicit uid",
      "input": {
        "uid": "other-uid"
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/checkUV2.php",
        "body": {
          "uid": "other-uid"
        }
      },
      "legacy": "api/checkUV2.js buildCheckUV2"
    },
    {
      "name": "empty uid is rejected",
      "input": {
        "uid": ""
      },
      "error": "at uid"
    },
    {
      "name": "numeric uid is rejected",
      "input": {
        "uid": 5
      },
      "error": "at uid"
    },
    {
      "name": "unknown field is rejected",
      "input": {
        "bogus": 1
      },
      "error": "Unrecognized key"
    }
  ]
}
