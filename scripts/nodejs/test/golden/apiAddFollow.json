{
  "endpoint": "apiAddFollow",
  "cases": [
    {
      "name": "uid1 defaults to the signed-in account",
      "input": {
        "uid2": "target-uid"
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/apiAddFollow.php",
        "body": {
          "uid1": "me-uid",
          "uid2": "target-uid"
        }
      },
      "legacy": "api/apiAddFollow.js buildApiAddFollow"
    },
    {
      "name": "explicit uid1",
      "input": {
        "uid1": "other-uid",
        "uid2": "target-uid"
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/apiAddFollow.php",
        "body": {
          "uid1": "other-uid",
          "uid2": "target-uid"
        }
      },
      "legacy": "api/apiAddFollow.js buildApiAddFollow"
    },
    {
      "name": "missing uid2 is rejected",
      "input": {},
      "error": "at uid2"
    },
    {
      "name": "numeric uid2 is rejected",
      "input": {
        "uid2": 42
      },
      "error": "at uid2"
    }
  ]
}
