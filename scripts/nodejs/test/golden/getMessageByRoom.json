{
  "endpoint": "getMessageByRoom",
  "cases": [
    {
      "name": "roomID only",
      "input": {
        "roomID": "79"
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getMessageByRoom.php",
        "body": {
          "roomID": "79"
        }
      },
      "legacy": "api/getMessageByRoom.js buildGetMessageByRoom"
    },
    {
      "name": "incognito true",
      "input": {
        "roomID": "79",
        "incognito": true
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getMessageByRoom.php",
        "body": {
          "roomID": "79",
          "incognito": true
        }
      },
      "legacy": "api/getMessageByRoom.js buildGetMessageByRoom"
    },
    {
      "name": "incognito false is sent",
      "input": {
        "roomID": "79",
        "incognito": false
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/getMessageByRoom.php",
        "body": {
          "roomID": "79",
          "incognito": false
        }
      },
      "legacy": "api/getMessageByRoom.js buildGetMessageByRoom"
    },
    {
      "name": "missing roomID is rejected",
      "input": {},
      "error": "at roomID"
    },
    {
      "name": "numeric roomID is rejected",
      "input": {
        "roomID": 79
      },
      "error": "at roomID"
    },
    {
      "name": "non-boolean incognito is rejected (legacy coerced it)",
      "input": {
        "roomID": "79",
        "incognito": 1
      },
      "error": "at incognito"
    }
  ]
}
