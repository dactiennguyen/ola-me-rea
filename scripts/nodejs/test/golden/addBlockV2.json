{
  "endpoint": "addBlockV2",
  "cases": [
    {
      "name": "uid defaults to the signed-in account",
      "input": {
        "userBlock": "peer-uid",
        "friendID": "friend-1"
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/addBlockV2.php",
        "body": {
          "uid": "me-uid",
          "userBlock": "peer-uid",
          "friendID": "friend-1"
        }
      },
      "legacy": "api/addBlockV2.js buildAddBlockV2"
    },
    {
      "name": "explicit uid",
      "input": {
        "uid": "other-uid",
        "userBlock": "peer-uid",
        "friendID": "friend-1"
      },
      "expected": {
        "method": "POST",
        "path": "faApi2/addBlockV2.php",
        "body": {
          "uid": "other-uid",
          "userBlock": "peer-uid",
          "friendID": "friend-1"
        }
      },
      "legacy": "api/addBlockV2.js buildAddBlockV2"
    },
    {
      "name": "missing friendID is rejected",
      "input": {
        "userBlock": "peer-uid"
      },
      "error": "at friendID"
    },
    {
      "name": "numeric userBlock is rejected",
      "input": {
        "userBlock": 123,
        "friendID": "friend-1"
      },
      "error": "at userBlock"
    },
    {
      "name": "whitespace-only userBlock is rejected",
      "input": {
        "userBlock": "  ",
        "friendID": "friend-1"
      },
      "error": "must be a non-empty string"
    },
    {
      "name": "unknown field is rejected",
      "input": {
        "userBlock": "p",
        "friendID": "f",
        "bogus": 1
      },
      "error": "Unrecognized key"
    }
  ]
}
