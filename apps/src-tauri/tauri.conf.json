{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ola Desktop",
  "version": "../package.json",
  "identifier": "dev.olamerea.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ola Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "backgroundColor": "#0B0F14",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://sgdev.vip https://sgdev.vip:3001 wss://sgdev.vip:3001; img-src 'self' data: blob: https:; media-src 'self' https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5REFBQTM4ODYxMUE1OEMKUldTTXBSR0dPS3JheVlqekx3VG1ucC8weG9mMzJ0Z3RXeE4wdjg2TkNIMUVEZDNzNE9wMXQzZkMK",
      "endpoints": [
        "https://github.com/dactiennguyen/ola-me-rea/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Manage Ola accounts, messages, explore and chat rooms",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
