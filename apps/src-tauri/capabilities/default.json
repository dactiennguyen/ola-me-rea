{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: Ola API, Firebase sign-in (accounts with a proxy) and the proxy IP check over the http plugin, JSON files over the store plugin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://sgdev.vip/*" },
        { "url": "https://identitytoolkit.googleapis.com/*" },
        { "url": "https://securetoken.googleapis.com/*" },
        { "url": "https://api.ipify.org/*" }
      ]
    }
  ]
}
